# Строка подключения к PostgreSQL.
# Для локальной разработки через docker-compose.yml (см. README) подойдёт значение по умолчанию.
DATABASE_URL="postgresql://bsb:bsb_local_password@localhost:5432/bsb_mvp?schema=public"

# Секрет для подписи сессионных cookie. Сгенерируйте свою случайную строку для продакшена, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-64-char-hex-string"

# Telegram-бот (см. раздел "Telegram-бот" в README).
# Токен получаете у @BotFather командой /newbot.
TELEGRAM_BOT_TOKEN=""
# Произвольная случайная строка — Telegram будет присылать её в заголовке
# каждого запроса к вебхуку, так вы убедитесь, что запрос действительно от Telegram.
TELEGRAM_WEBHOOK_SECRET=""
# Username бота без @ (например bsb_beton_bot) — используется только для ссылки
# в личном кабинете "Открыть бота".
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Публичный адрес сайта в проде (без / на конце) — нужен, чтобы собрать ссылку
# на Telegram Mini App (<домен>/miniapp) для кнопок бота.
NEXT_PUBLIC_APP_URL=""

# Ключ JS API Яндекс.Карт (v3) — показывает саму карту на сайте.
# Получить: developer.tech.yandex.ru → создать ключ с продуктом
# "JavaScript API и HTTP Геокодер" (это ОДИН продукт в кабинете Яндекса,
# выбирается один раз при создании ключа — не два отдельных ключа).
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""

# Ключ для серверного геокодирования (превращение адреса в координаты и
# обратно) через HTTP Geocoder API — см. lib/yandex-geocoder.ts. Если ключ
# выше уже создан с продуктом "JavaScript API и HTTP Геокодер" — можно
# оставить эту переменную пустой, тогда сервер переиспользует ключ карты.
# Если геокодирование не работает и в логах видно "403" — почти наверняка
# у ключа карты НЕ подключён продукт "HTTP Геокодер": либо включите его в
# кабинете Яндекса для того же ключа, либо создайте отдельный ключ под HTTP
# Геокодер и укажите его здесь.
YANDEX_GEOCODER_API_KEY=""

# Алертинг по "зависшим" заказам (см. раздел "Алертинг" в README).
# Секрет для защиты /api/cron/check-stale-orders — придумайте случайную строку.
CRON_SECRET=""
# Через сколько минут без завода считать заказ зависшим и слать алерт админу.
STALE_ORDER_MINUTES="30"
