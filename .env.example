# Строка подключения к PostgreSQL.
# Для локальной разработки через docker-compose.yml (см. README) подойдёт значение по умолчанию.
DATABASE_URL="postgresql://bsb:bsb_local_password@localhost:5432/bsb_mvp?schema=public"

# Секрет для подписи сессионных cookie. Сгенерируйте свою случайную строку для продакшена, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-64-char-hex-string"

# Telegram-бот (см. раздел "Telegram-бот" в README).
# Токен получаете у @BotFather командой /newbot.
TELEGRAM_BOT_TOKEN=""
# Произвольная случайная строка — Telegram будет присылать её в заголовке
# каждого запроса к вебхуку, так вы убедитесь, что запрос действительно от Telegram.
TELEGRAM_WEBHOOK_SECRET=""
# Username бота без @ (например bsb_beton_bot) — используется только для ссылки
# в личном кабинете "Открыть бота".
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
