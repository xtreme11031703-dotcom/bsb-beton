// БСБ MVP — схема базы данных
// Роли: CLIENT, PLANT, ADMIN
// Ключевая логика: Order -> много OrderPlant (доступность заказа заводу),
// первый завод, который атомарно "берёт" заказ, становится Order.plantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PLANT
  ADMIN
}

enum PlantStatus {
  ACTIVE
  INACTIVE
}

// Категории товара — 1 в 1 соответствуют разделам каталога bsb-beton.ru/catalog
// (см. lib/company.ts -> serviceCategories и lib/catalog.ts). Пришли на смену
// MaterialType: теперь это и категория позиции в корзине заказа, и то, что
// завод указывает у себя в "Доступные категории" (Plant.categories).
enum ProductCategory {
  BETON // Товарный бетон
  TOSHCHIY_BETON // Тощий бетон
  VYSOKOPROCHNYY_BETON // Высокопрочный бетон
  POLISTIROLBETON // Полистиролбетон
  RASTVORY // Растворы и пескобетон
  NASOS // Аренда бетононасоса — заказывается отдельной позицией в корзине
}

// Наполнитель для товарного бетона (bsb-beton.ru: "бетон на гравии, граните
// и керамзитобетон") — актуально только для категории BETON.
enum ConcreteAggregate {
  GRAVEL // На гравии
  GRANITE // На граните
  EXPANDED_CLAY // Керамзитобетон
}

// Подвид раствора — актуально только для категории RASTVORY.
enum MortarKind {
  CEMENT // Цементный раствор
  SPECIAL // Специальный раствор
  SAND_CONCRETE // Пескобетон
}

// Полный набор марок по всем категориям каталога сразу (не каждая категория
// использует все — см. lib/catalog.ts, там же таблица цен и то, какие марки
// доступны для конкретного сочетания категория+наполнитель/вид раствора).
enum ConcreteGrade {
  M50
  M75
  M100
  M150
  M200
  M250
  M300
  M350
  M400
  M450
  M500
  M550
  M600
  M700
  M800
  M900
  M1000
}

enum PumpType {
  AUTO
  STATIONARY
}

enum OrderStatus {
  NEW
  SEARCHING_PLANT
  PLANT_ASSIGNED
  CONFIRMED
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

// Статус конкретного "предложения" заказа конкретному заводу
enum OrderPlantStatus {
  AVAILABLE
  TAKEN
  EXPIRED
}

enum ChatThreadStatus {
  OPEN
  CLOSED
}

enum ChatSender {
  VISITOR
  ADMIN
  // Автоматический ответ бота по FAQ (lib/faq-bot.ts) — до того, как в
  // диалог включится человек.
  BOT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CLIENT)
  // Если роль PLANT — пользователь привязан к заводу, от имени которого действует
  plantId      String?
  plant        Plant?   @relation(fields: [plantId], references: [id])
  createdAt    DateTime @default(now())

  // Telegram-уведомления: chatId заполняется после того, как пользователь
  // отправил боту одноразовый код из личного кабинета (см. lib/telegram.ts).
  telegramChatId   String? @unique
  telegramLinkCode String? @unique

  ordersAsClient Order[]              @relation("ClientOrders")
  statusChanges  OrderStatusHistory[]
  chatThreads    ChatThread[]
}

model Plant {
  id         String       @id @default(cuid())
  name       String
  address    String
  latitude   Float
  longitude  Float
  phone      String
  status     PlantStatus  @default(ACTIVE)
  radiusKm   Int          @default(50)
  // Какие категории каталога завод может производить/предоставлять — по
  // умолчанию все, чтобы `prisma db push` безопасно проставил значение уже
  // существующим заводам без ручной миграции данных (см. scripts/add-real-plants.ts).
  categories ProductCategory[] @default([BETON, TOSHCHIY_BETON, VYSOKOPROCHNYY_BETON, POLISTIROLBETON, RASTVORY, NASOS])
  createdAt  DateTime     @default(now())

  users       User[]
  orders      Order[]       @relation("AssignedOrders")
  orderPlants OrderPlant[]
}

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique // например БСБ-000123

  clientId String
  client   User   @relation("ClientOrders", fields: [clientId], references: [id])

  plantId String? // назначенный завод (заполняется, когда кто-то "берёт" заказ)
  plant   Plant?  @relation("AssignedOrders", fields: [plantId], references: [id])

  // Позиции корзины — заказ может содержать несколько разных товаров
  // (например, бетон М300 + аренда насоса одной строкой). Раньше эти поля
  // были прямо на Order (один материал на заказ) — вынесены в OrderItem,
  // когда добавили полноценную корзину (см. lib/catalog.ts).
  items OrderItem[]

  addressText String
  latitude    Float
  longitude   Float

  deliveryDate     DateTime
  deliveryTimeFrom String // "10:00"
  deliveryTimeTo   String // "12:00"

  contactName  String
  contactPhone String
  comment      String?

  status OrderStatus @default(NEW)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  acceptedAt DateTime?

  // Когда админу отправлен алерт "заказ долго висит без завода" — чтобы не
  // слать его повторно на каждый прогон крона (см. app/api/cron/check-stale-orders).
  staleAlertSentAt DateTime?

  orderPlants   OrderPlant[]
  statusHistory OrderStatusHistory[]

  @@index([status])
  @@index([clientId])
}

// Одна позиция корзины заказа. Набор заполненных полей зависит от category —
// см. lib/catalog.ts (там же лейблы и то, какие поля показывать в форме для
// каждой категории). Например, для NASOS не заполняются concreteGrade/aggregate/
// mortarKind, зато заполняются pumpType/pumpLength.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  category ProductCategory

  // Бетон/тощий бетон/высокопрочный бетон/полистиролбетон
  concreteGrade ConcreteGrade?
  aggregate     ConcreteAggregate? // только для BETON ("на гравии/граните" или керамзитобетон)
  concreteClass String? // например "B22.5"
  mobility      String?
  frostResistance String?
  waterResistance String?
  hasFiber        Boolean @default(false)

  // Растворы
  mortarKind MortarKind?

  // Аренда бетононасоса
  pumpType   PumpType?
  pumpLength String? // например "36" или "Другой"
  pumpNote   String?

  // Объём в м³ — не используется для NASOS (там позиция считается штучно/по вызову)
  quantity Float @default(0)

  // Цена — снимок на момент оформления заказа (см. lib/catalog.ts), а не
  // ссылка на живой прайс-лист: если прайс потом поменяется (или его вообще
  // заменят отдельным калькулятором — см. комментарий в lib/catalog.ts),
  // история уже оформленных заказов не должна задним числом пересчитываться.
  // null — если для сочетания параметров цены в прайсе не нашлось (например,
  // произвольная длина стрелы насоса "Другой") — тогда сумма уточняется.
  unitPrice Float? // руб. за м³ (для NASOS — не используется, там сразу lineTotal)
  lineTotal Float? // итог по позиции: unitPrice * quantity, либо фиксированная цена аренды насоса

  additionalWishes String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

// Связь "заказ доступен заводу" — по одной строке на каждый подходящий завод.
// Именно эта таблица — центр логики "кто первый, тот и получил".
model OrderPlant {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id])
  plantId   String
  plant     Plant            @relation(fields: [plantId], references: [id])
  status    OrderPlantStatus @default(AVAILABLE)
  distanceKm Float?
  createdAt DateTime         @default(now())
  respondedAt DateTime?

  @@unique([orderId, plantId])
  @@index([plantId, status])
}

model OrderStatusHistory {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id])
  status        OrderStatus
  note          String?
  changedByUserId String?
  changedByUser User?       @relation(fields: [changedByUserId], references: [id])
  createdAt     DateTime    @default(now())
}

// Живой чат-виджет на сайте — доступен всем посетителям (не только
// залогиненным клиентам), поэтому личность привязана к анонимному
// visitorKey из cookie, а не только к User. Если писал залогиненный
// клиент — дополнительно связываем с его аккаунтом (clientId), это чисто
// для удобства админа при просмотре списка диалогов.
model ChatThread {
  id        String @id @default(cuid())
  // Короткий код треда для ответа из Telegram: "/reply K7QX2M текст".
  shortCode String @unique
  // Анонимный идентификатор посетителя из cookie — так продолжаем диалог
  // при возврате на сайт без входа в аккаунт.
  visitorKey String @unique
  // Стабильный порядковый номер анонимного посетителя ("Клиент 12"), не
  // зависит от того, что мы могли когда-то ошибочно записать в visitorName —
  // используется как запасной вариант отображаемого имени, когда тред не
  // привязан к аккаунту клиента.
  visitorSeq Int @unique @default(autoincrement())

  visitorName String?

  clientId String?
  client   User?   @relation(fields: [clientId], references: [id])

  status ChatThreadStatus @default(OPEN)

  // Отдельные флаги непрочитанного для каждой стороны — админ должен
  // увидеть новый вопрос посетителя, а посетитель — новый ответ админа.
  adminUnread   Boolean @default(true)
  visitorUnread Boolean @default(false)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages ChatMessage[]

  @@index([status, lastMessageAt])
}

model ChatMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id])
  sender   ChatSender
  text     String

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}
